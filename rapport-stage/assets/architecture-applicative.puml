@startuml
title Architecture applicative de la plateforme SSE

skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam componentStyle rectangle
skinparam linetype ortho

actor "Utilisateur final" as User

package "Couche de présentation" {
  component "Application web\nReact + TypeScript" as React
  component "Gestion d'état, routage,\ni18n et composants UI" as FrontCore
}

package "Couche d'accès et de sécurité" {
  component "API REST\nSpring Boot" as API
  component "Spring Security\nJWT + contrôle d'accès" as Security
}

package "Couche métier" {
  component "Comptes et organismes" as Accounts
  component "Évaluations et réponses" as Evaluation
  component "Validation et scoring" as Scoring
  component "Notifications, audit\net réclamations" as Support
  component "Rapports PDF / Excel" as Reports
}

package "Couche de persistance" {
  database "PostgreSQL" as DB
  folder "Stockage des\njustificatifs" as Files
}

cloud "Services externes" {
  component "Serveur SMTP" as SMTP
  component "Service de traduction\n(optionnel)" as Translation
}

User --> React : HTTPS
React --> FrontCore
FrontCore --> API : JSON / REST
API --> Security : authentifier et autoriser
Security --> Accounts
Security --> Evaluation
Evaluation --> Scoring
Accounts --> DB
Evaluation --> DB
Scoring --> DB
Support --> DB
Reports --> DB
Evaluation --> Files
Support --> SMTP
API --> Translation
Reports --> React : fichiers PDF / XLSX

@enduml
