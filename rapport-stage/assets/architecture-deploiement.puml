@startuml
title Architecture de déploiement de la plateforme SSE

skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam componentStyle rectangle
skinparam linetype ortho

node "Poste client" as Client {
  artifact "Navigateur web" as Browser
}

cloud "Amazon Web Services" as AWS {
  node "Instance EC2\nUbuntu" as EC2 {
    node "Docker Compose" as Docker {
      node "Conteneur frontend" as Front {
        component "Nginx" as Nginx
        artifact "Application React\ncompilée" as Bundle
      }
      node "Conteneur backend" as Back {
        component "Spring Boot\nJava 17" as Spring
      }
      database "Conteneur PostgreSQL 15" as PostgreSQL
      folder "Volume persistant\njustificatifs" as Uploads
      folder "Volume persistant\ndonnées" as Data
    }
  }
}

Browser --> Nginx : HTTP/HTTPS
Nginx --> Bundle : ressources statiques
Nginx --> Spring : /api
Spring --> PostgreSQL : JDBC
Spring --> Uploads : lecture / écriture
PostgreSQL --> Data : persistance

@enduml
